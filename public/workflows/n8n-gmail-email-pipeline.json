    {
      "parameters": {
        "jsCode": "// Map existing Gmail label names -> ids (case-insensitive)\nconst labels = $('Get Labels').all().map(l => l.json || {});\nconst nameToId = {};\nfor (const l of labels) {\n  if (l && l.name) nameToId[String(l.name).toLowerCase()] = l.id;\n}\n\n// Re-pair with each prepared email and attach the resolved label id (or '' if it must be created)\nconst prepared = $('Prepare Email Data').all();\nconst out = [];\nfor (const p of prepared) {\n  const j = p.json || {};\n  const cat = (j.category || '').trim();\n  const labelId = cat ? (nameToId[cat.toLowerCase()] || '') : '';\n  out.push({ json: Object.assign({}, j, { categoryLabelId: labelId }) });\n}\nreturn out;"
      },
