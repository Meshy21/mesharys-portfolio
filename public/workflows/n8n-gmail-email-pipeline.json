    {
      "parameters": {
        "jsCode": "// Sender subfolders were created in-order for each attachment-bearing email.\nconst subfolders = $('Create Sender Folder').all();\n\n// The attachment-bearing prepared emails, in the same order the IF passed them.\nconst prepared = $('Prepare Email Data').all().filter(p => p.json && p.json.attachmentCount > 0);\n\n// Emit one item per attachment, carrying the single binary under 'data'.\nconst out = [];\nfor (let i = 0; i < prepared.length; i++) {\n  const sub = subfolders[i];\n  if (!sub || !sub.json || !sub.json.id) continue;\n  const folderId = sub.json.id;\n  const bin = prepared[i].binary || {};\n  for (const key of Object.keys(bin)) {\n    const b = bin[key];\n    out.push({\n      json: {\n        folderId: folderId,\n        fileName: b.fileName || b.filename || key,\n        messageId: prepared[i].json.messageId,\n        senderName: prepared[i].json.senderName,\n      },\n      binary: { data: b },\n    });\n  }\n}\nreturn out;"
      },
