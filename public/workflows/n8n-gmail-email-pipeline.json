    {
      "parameters": {
        "jsCode": "const triggerItems = $('Gmail Trigger').all();\nconst items = $input.all();\nconst out = [];\n\nfor (let i = 0; i < items.length; i++) {\n  // AI-extracted fields (Information Extractor nests result under 'output')\n  const src = items[i].json || {};\n  const ex = src.output || src;\n\n  // Original email + binary from the trigger, paired by index\n  const t = (triggerItems[i] && triggerItems[i].json) || {};\n  const bin = (triggerItems[i] && triggerItems[i].binary) || {};\n\n  // --- Sender: prefer AI, fall back to parsing the raw From header ---\n  let senderName = (ex.senderName || '').trim();\n  let senderEmail = (ex.senderEmail || '').trim();\n  if (!senderName || !senderEmail) {\n    let fromRaw = t.from || t.From || '';\n    if (fromRaw && typeof fromRaw === 'object') {\n      if (Array.isArray(fromRaw.value) && fromRaw.value.length) {\n        senderName = senderName || (fromRaw.value[0].name || '');\n        senderEmail = senderEmail || (fromRaw.value[0].address || '');\n      } else {\n        senderName = senderName || (fromRaw.name || '');\n        senderEmail = senderEmail || (fromRaw.address || '');\n      }\n    } else if (typeof fromRaw === 'string') {\n      const m = fromRaw.match(/^\\s*\"?([^\"<]*?)\"?\\s*<([^>]+)>/);\n      if (m) {\n        senderName = senderName || (m[1] || '').trim();\n        senderEmail = senderEmail || (m[2] || '').trim();\n      } else {\n        senderEmail = senderEmail || fromRaw.trim();\n      }\n    }\n  }\n  if (!senderName) senderName = (senderEmail.split('@')[0] || 'Unknown Sender');\n\n  // --- Category from AI classification ---\n  const category = (ex.category || 'Uncategorized').trim() || 'Uncategorized';\n\n  // --- Subject ---\n  const subject = (ex.subject || t.subject || t.Subject || '').toString();\n\n  // --- Date received: use the actual email date, normalized to YYYY-MM-DD ---\n  const rawDate = t.date || t.internalDate || t.Date || ex.dateReceived || null;\n  let dt;\n  if (rawDate !== null && rawDate !== undefined && rawDate !== '') {\n    dt = new Date(isNaN(rawDate) ? rawDate : Number(rawDate));\n  } else {\n    dt = new Date();\n  }\n  const dateStr = isNaN(dt.getTime()) ? new Date().toISOString().slice(0, 10) : dt.toISOString().slice(0, 10);\n\n  // --- Sanitize names for Drive folders ---\n  const clean = (s) => String(s || '').replace(/[\\\\/:*?\"<>|]/g, '_').replace(/\\s+/g, ' ').trim();\n  const safeSender = clean(senderName) || 'Unknown Sender';\n  const safeCategory = clean(category) || 'Uncategorized';\n  // Parent folder grouped by category + date; sender-named subfolder underneath\n  const parentFolderName = safeCategory + ' - ' + dateStr;\n  const senderFolderName = safeSender;\n  const folderName = parentFolderName + ' / ' + senderFolderName;\n\n  // --- Attachments ---\n  const attachmentCount = Object.keys(bin).length;\n\n  out.push({\n    json: {\n      messageId: t.id || t.messageId || '',\n      threadId: t.threadId || '',\n      senderName: senderName,\n      senderEmail: senderEmail,\n      subject: subject,\n      dateReceived: dateStr,\n      category: category,\n      parentFolderName: parentFolderName,\n      senderFolderName: senderFolderName,\n      folderName: folderName,\n      attachmentCount: attachmentCount,\n    },\n    binary: bin,\n  });\n}\nreturn out;"
      },
